{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "accent",
					"color": "#cb2026",
					"name": "Accent"
				},
				{
					"slug": "accent-light",
					"color": "#e03a3f",
					"name": "Accent light"
				},
				{
					"slug": "accent-dark",
					"color": "#a11b20",
					"name": "Accent dark"
				},
				{
					"slug": "paper",
					"color": "#ffffff",
					"name": "Paper"
				},
				{
					"slug": "ink",
					"color": "#1a1a1a",
					"name": "Ink"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "surface-mid",
					"color": "#f5f5f5",
					"name": "Surface mid"
				},
				{
					"slug": "surface-high",
					"color": "#ebebeb",
					"name": "Surface high"
				},
				{
					"slug": "text-secondary",
					"color": "#404040",
					"name": "Text secondary"
				},
				{
					"slug": "text-muted",
					"color": "#6b6b6b",
					"name": "Text muted"
				},
				{
					"slug": "border-subtle",
					"color": "#eeeeee",
					"name": "Border subtle"
				},
				{
					"slug": "border-mid",
					"color": "#dddddd",
					"name": "Border mid"
				},
				{
					"slug": "border-strong",
					"color": "#cccccc",
					"name": "Border strong"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Playfair Display', serif",
					"name": "Playfair Display",
					"slug": "display"
				},
				{
					"fontFamily": "'DM Sans', sans-serif",
					"name": "DM Sans",
					"slug": "body"
				}
			]
		},
		"layout": {
			"contentSize": "72rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "2px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-light)"
					}
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50, 2.5rem)",
						"bottom": "var(--wp--preset--spacing--50, 2.5rem)"
					}
				}
			}
		}
	}
}
